package com.kuakua.mirror.shared.controller;

import com.kuakua.mirror.dto.*;
import com.kuakua.mirror.model.Message;
import com.kuakua.mirror.model.Moment;
import com.kuakua.mirror.repository.MessageRepository;
import com.kuakua.mirror.repository.MomentRepository;
import com.kuakua.mirror.service.ContextService;
import com.kuakua.mirror.service.ProfileService;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import reactor.core.publisher.Mono;

import java.time.LocalDateTime;
import java.util.List;
import java.util.stream.Collectors;

/**
 * 消息管理控制器
 */
@Slf4j
@RestController
@RequestMapping("/api/messages")
@RequiredArgsConstructor
public class MessageController {

    private final MessageRepository messageRepository;
    private final MomentRepository momentRepository;
    private final ContextService contextService;
    private final ProfileService profileService;

    /**
     * 发送消息并获取 AI 回应
     */
    @PostMapping("/send")
    public Mono<ResponseEntity<ApiResponse<MessageResponse>>> sendMessage(
            @Valid @RequestBody MessageRequest request,
            @RequestAttribute("userId") Long userId) {

        log.info("发送消息: userId={}, momentId={}", userId, request.getMomentId());

        // 验证 Moment 归属
        return Mono.fromCallable(() -> {
            Moment moment = momentRepository.findById(request.getMomentId())
                .filter(m -> m.getUserId().equals(userId))
                .filter(m -> m.getStatus() == Moment.MomentStatus.ACTIVE)
                .orElseThrow(() -> new IllegalArgumentException("Moment 不存在、无权访问或已结束"));
            return moment;
        })
        .flatMap(moment -> {
            // 保存用户消息
            Message userMessage = new Message();
            userMessage.setMomentId(request.getMomentId());
            userMessage.setRole(Message.MessageRole.USER);
            userMessage.setContent(request.getContent());
            userMessage.setTimestamp(LocalDateTime.now());
            messageRepository.save(userMessage);

            // 获取当前对话上下文
            String conversationContext = contextService.buildConversationContext(userId, request.getMomentId());

            // 生成个性化回应
            return profileService.generatePersonalizedResponse(userId, request.getContent(), conversationContext)
                .map(aiResponse -> {
                    // 保存 AI 回应
                    Message assistantMessage = new Message();
                    assistantMessage.setMomentId(request.getMomentId());
                    assistantMessage.setRole(Message.MessageRole.ASSISTANT);
                    assistantMessage.setContent(aiResponse);
                    assistantMessage.setTimestamp(LocalDateTime.now());
                    messageRepository.save(assistantMessage);

                    return assistantMessage;
                });
        })
        .map(message -> {
            MessageResponse response = toMessageResponse(message);
            return ResponseEntity.ok(ApiResponse.success("消息已发送", response));
        })
        .onErrorResume(e -> {
            log.error("发送消息失败: userId={}, momentId={}", userId, request.getMomentId(), e);
            return Mono.just(ResponseEntity.badRequest()
                .body(ApiResponse.error("发送消息失败: " + e.getMessage())));
        });
    }

    /**
     * 获取指定 Moment 的消息历史
     */
    @GetMapping("/history")
    public ResponseEntity<ApiResponse<List<MessageResponse>>> getMessageHistory(
            @RequestParam Long momentId,
            @RequestAttribute("userId") Long userId,
            @RequestParam(defaultValue = "100") int limit) {

        log.info("获取消息历史: userId={}, momentId={}, limit={}", userId, momentId, limit);

        try {
            // 验证 Moment 归属
            boolean momentExists = momentRepository.findById(momentId)
                .filter(m -> m.getUserId().equals(userId))
                .isPresent();

            if (!momentExists) {
                return ResponseEntity.status(404)
                    .body(ApiResponse.error("Moment 不存在或无权访问"));
            }

            // 获取消息历史
            List<Message> messages = messageRepository.findByMomentIdOrderByTimestampAsc(momentId);

            List<MessageResponse> responses = messages.stream()
                .limit(limit)
                .map(this::toMessageResponse)
                .collect(Collectors.toList());

            return ResponseEntity.ok(ApiResponse.success(responses));
        } catch (Exception e) {
            log.error("获取消息历史失败: momentId={}", momentId, e);
            return ResponseEntity.internalServerError()
                .body(ApiResponse.error("获取消息历史失败: " + e.getMessage()));
        }
    }

    /**
     * 转换为响应 DTO
     */
    private MessageResponse toMessageResponse(Message message) {
        return MessageResponse.builder()
            .id(message.getId())
            .momentId(message.getMomentId())
            .role(message.getRole().name())
            .content(message.getContent())
            .timestamp(message.getTimestamp())
            .build();
    }
}
