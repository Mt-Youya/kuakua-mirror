package com.kuakua.mirror.ai.api;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.kuakua.mirror.audio.infra.ASRService;
import com.kuakua.mirror.audio.infra.TTSService;
import com.kuakua.mirror.ai.infra.LLMService;
import com.kuakua.mirror.conversation.infra.SessionManager;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.socket.WebSocketHandler;
import org.springframework.web.reactive.socket.WebSocketMessage;
import org.springframework.web.reactive.socket.WebSocketSession;
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;

import java.util.Base64;
import java.util.List;
import java.util.Map;

/**
 * 实时语音对话 WebSocket 处理器
 * 处理客户端的实时音频输入和输出
 */
@Slf4j
@Component
@RequiredArgsConstructor
public class RealtimeWebSocketHandler implements WebSocketHandler {

    private final SessionManager sessionManager;
    private final ASRService asrService;
    private final LLMService llmService;
    private final TTSService ttsService;
    private final ObjectMapper objectMapper;

    @Override
    public Mono<Void> handle(WebSocketSession session) {
        String sessionId = session.getId();
        log.info("WebSocket连接建立: sessionId={}", sessionId);

        // 创建会话
        sessionManager.getOrCreateSession(sessionId, null);

        // 接收客户端消息
        Flux<Map<String, Object>> incomingMessages = session.receive()
                .map(WebSocketMessage::getPayloadAsText)
                .flatMap(this::parseMessage)
                .doOnNext(msg -> log.debug("收到消息: sessionId={}, type={}", sessionId, msg.get("type")));

        // 处理消息并生成响应
        Flux<WebSocketMessage> outgoingMessages = incomingMessages
                .flatMap(msg -> handleMessage(session, sessionId, msg))
                .onErrorResume(error -> {
                    log.error("处理消息时出错: sessionId={}", sessionId, error);
                    return sendError(session, error.getMessage());
                });

        // 发送响应并处理连接关闭
        return session.send(outgoingMessages)
                .doOnTerminate(() -> {
                    log.info("WebSocket连接关闭: sessionId={}", sessionId);
                    sessionManager.removeSession(sessionId);
                });
    }

    /**
     * 解析 JSON 消息
     */
    private Mono<Map<String, Object>> parseMessage(String json) {
        return Mono.fromCallable(() -> {
            @SuppressWarnings("unchecked")
            Map<String, Object> map = objectMapper.readValue(json, Map.class);
            return map;
        }).onErrorResume(error -> {
            log.error("JSON解析失败: {}", error.getMessage());
            return Mono.empty();
        });
    }

    /**
     * 处理客户端消息
     */
    private Flux<WebSocketMessage> handleMessage(WebSocketSession session, String sessionId, Map<String, Object> message) {
        String type = (String) message.get("type");

        return switch (type) {
            case "audio.input" -> handleAudioInput(session, sessionId, message);
            case "audio.input_complete" -> handleAudioInputComplete(session, sessionId);
            case "conversation.item.create" -> handleConversationItemCreate(session, sessionId, message);
            case "response.create" -> handleResponseCreate(session, sessionId);
            case "response.cancel" -> handleResponseCancel(session, sessionId);
            case "session.update" -> handleSessionUpdate(session, sessionId, message);
            default -> {
                log.warn("未知消息类型: type={}", type);
                yield Flux.empty();
            }
        };
    }

    /**
     * 处理音频输入
     */
    private Flux<WebSocketMessage> handleAudioInput(WebSocketSession session, String sessionId, Map<String, Object> message) {
        String audioBase64 = (String) message.get("audio");
        if (audioBase64 == null || audioBase64.isEmpty()) {
            return Flux.empty();
        }

        try {
            // 解码 base64 音频
            byte[] audioData = Base64.getDecoder().decode(audioBase64);

            // 添加到缓冲区
            asrService.processAudioFrame(sessionId, audioData);

            return Flux.empty();
        } catch (Exception e) {
            log.error("音频输入处理失败: sessionId={}", sessionId, e);
            return sendError(session, "Audio processing failed");
        }
    }

    /**
     * 处理音频输入完成
     */
    private Flux<WebSocketMessage> handleAudioInputComplete(WebSocketSession session, String sessionId) {
        log.info("音频输入完成，开始识别: sessionId={}", sessionId);

        sessionManager.setSessionState(sessionId, SessionManager.SessionState.TRANSCRIBING);

        // 执行语音识别
        return asrService.finalizeTranscription(sessionId)
                .flatMapMany(transcription -> {
                    if (transcription.isEmpty()) {
                        return sendEvent(session, "conversation.item.input_audio_transcription.completed",
                                Map.of("transcript", ""));
                    }

                    // 发送转录完成事件
                    return Flux.concat(
                            sendEvent(session, "conversation.item.input_audio_transcription.completed",
                                    Map.of("transcript", transcription)),
                            // 自动触发响应生成
                            handleResponseCreate(session, sessionId)
                    );
                })
                .onErrorResume(error -> {
                    log.error("语音识别失败: sessionId={}", sessionId, error);
                    sessionManager.setSessionState(sessionId, SessionManager.SessionState.IDLE);
                    return sendError(session, "Transcription failed");
                });
    }

    /**
     * 处理创建对话项（用户文本输入）
     */
    private Flux<WebSocketMessage> handleConversationItemCreate(WebSocketSession session, String sessionId, Map<String, Object> message) {
        @SuppressWarnings("unchecked")
        Map<String, Object> item = (Map<String, Object>) message.get("item");
        if (item == null) {
            return Flux.empty();
        }

        String role = (String) item.get("role");
        @SuppressWarnings("unchecked")
        List<Map<String, Object>> content = (List<Map<String, Object>>) item.get("content");

        if ("user".equals(role) && content != null && !content.isEmpty()) {
            String text = (String) content.get(0).get("text");
            if (text != null && !text.isEmpty()) {
                sessionManager.addMessage(sessionId, "user", text);
                log.info("用户文本消息已添加: sessionId={}", sessionId);
            }
        }

        return sendEvent(session, "conversation.item.created", Map.of("item", item));
    }

    /**
     * 处理响应创建请求
     */
    private Flux<WebSocketMessage> handleResponseCreate(WebSocketSession session, String sessionId) {
        log.info("开始生成响应: sessionId={}", sessionId);

        sessionManager.setSessionState(sessionId, SessionManager.SessionState.RESPONDING);

        // 获取最后一条用户消息
        SessionManager.SessionContext context = sessionManager.getSession(sessionId);
        if (context == null) {
            return sendError(session, "Session not found");
        }

        java.util.List<Map<String, String>> history = context.getConversationHistory();
        if (history.isEmpty()) {
            return sendError(session, "No user message to respond to");
        }

        String lastUserMessage = history.get(history.size() - 1).get("content");

        // 生成 LLM 响应
        Flux<String> llmStream = llmService.generateStreamResponse(sessionId, lastUserMessage);

        // 将文本转换为语音
        Flux<byte[]> audioStream = ttsService.synthesizeSpeechStream(sessionId, llmStream);

        // 发送响应开始事件
        Flux<WebSocketMessage> startEvent = sendEvent(session, "response.audio.delta",
                Map.of("delta", ""));

        // 发送音频数据
        Flux<WebSocketMessage> audioMessages = audioStream
                .map(audioChunk -> {
                    String audioBase64 = Base64.getEncoder().encodeToString(audioChunk);
                    return createEvent("response.audio.delta", Map.of("delta", audioBase64));
                })
                .map(session::textMessage);

        // 发送完成事件
        Flux<WebSocketMessage> doneEvent = Flux.just(session.textMessage(
                createEvent("response.audio.done", Map.of())
        )).doOnNext(msg -> {
            sessionManager.setSessionState(sessionId, SessionManager.SessionState.IDLE);
            log.info("响应生成完成: sessionId={}", sessionId);
        });

        return Flux.concat(startEvent, audioMessages, doneEvent);
    }

    /**
     * 处理响应取消
     */
    private Flux<WebSocketMessage> handleResponseCancel(WebSocketSession session, String sessionId) {
        log.info("取消响应: sessionId={}", sessionId);

        asrService.abortTranscription(sessionId);
        llmService.abortGeneration(sessionId);
        ttsService.abortSynthesis(sessionId);

        return sendEvent(session, "response.cancelled", Map.of());
    }

    /**
     * 处理会话更新
     */
    private Flux<WebSocketMessage> handleSessionUpdate(WebSocketSession session, String sessionId, Map<String, Object> message) {
        @SuppressWarnings("unchecked")
        Map<String, Object> sessionConfig = (Map<String, Object>) message.get("session");
        if (sessionConfig == null) {
            return Flux.empty();
        }

        // 更新系统提示
        @SuppressWarnings("unchecked")
        List<Map<String, String>> instructions = (List<Map<String, String>>) sessionConfig.get("instructions");
        if (instructions != null && !instructions.isEmpty()) {
            String systemPrompt = instructions.get(0).get("text");
            if (systemPrompt != null) {
                llmService.setSystemPrompt(sessionId, systemPrompt);
            }
        }

        // 更新语音设置
        String voice = (String) sessionConfig.get("voice");
        if (voice != null) {
            ttsService.setVoice(sessionId, voice);
        }

        log.info("会话配置已更新: sessionId={}", sessionId);

        return sendEvent(session, "session.updated", Map.of("session", sessionConfig));
    }

    /**
     * 发送事件消息
     */
    private Flux<WebSocketMessage> sendEvent(WebSocketSession session, String eventType, Map<String, Object> data) {
        return Flux.just(session.textMessage(createEvent(eventType, data)));
    }

    /**
     * 发送错误消息
     */
    private Flux<WebSocketMessage> sendError(WebSocketSession session, String message) {
        return sendEvent(session, "error", Map.of("message", message));
    }

    /**
     * 创建事件 JSON
     */
    private String createEvent(String type, Map<String, Object> data) {
        try {
            Map<String, Object> event = new java.util.HashMap<>();
            event.put("type", type);
            event.putAll(data);
            return objectMapper.writeValueAsString(event);
        } catch (Exception e) {
            log.error("创建事件失败: type={}", type, e);
            return "{}";
        }
    }
}
