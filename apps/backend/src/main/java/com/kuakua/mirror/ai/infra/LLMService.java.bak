package com.kuakua.mirror.ai.infra;

import com.kuakua.mirror.conversation.infra.SessionManager;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Flux;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * 大语言模型服务
 * 封装 LLM（Large Language Model）业务逻辑
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class LLMService {

    private final OpenAIService openAIService;
    private final SessionManager sessionManager;

    private static final int MAX_HISTORY_LENGTH = 20; // 最大历史对话轮数
    private static final String DEFAULT_SYSTEM_PROMPT =
            "你是一个友好、乐于助人的AI助手。请用自然、亲切的语气回答用户的问题。";

    /**
     * 生成流式响应
     *
     * @param sessionId 会话ID
     * @param userMessage 用户消息
     * @return 流式响应文本
     */
    public Flux<String> generateStreamResponse(String sessionId, String userMessage) {
        SessionManager.SessionContext context = sessionManager.getSession(sessionId);
        if (context == null) {
            log.warn("会话不存在，无法生成响应: sessionId={}", sessionId);
            return Flux.error(new IllegalStateException("Session not found: " + sessionId));
        }

        // 构建对话历史
        List<Map<String, String>> messages = buildMessages(context, userMessage);

        log.info("开始生成LLM响应: sessionId={}, 历史消息数={}",
                sessionId, messages.size());

        // 调用 OpenAI API
        return openAIService.chatCompletionStream(messages)
                .doOnNext(chunk -> {
                    // 累积助手响应
                    if (context.getCurrentAssistantMessage() == null) {
                        context.setCurrentAssistantMessage(new StringBuilder());
                    }
                    context.getCurrentAssistantMessage().append(chunk);
                })
                .doOnComplete(() -> {
                    // 完成后保存助手响应到历史
                    String fullResponse = context.getCurrentAssistantMessage() != null
                            ? context.getCurrentAssistantMessage().toString()
                            : "";

                    if (!fullResponse.isEmpty()) {
                        sessionManager.addMessage(sessionId, "assistant", fullResponse);
                        log.info("LLM响应完成: sessionId={}, 响应长度={}字符",
                                sessionId, fullResponse.length());
                    }

                    // 清空当前助手消息
                    context.setCurrentAssistantMessage(null);
                    sessionManager.updateActivity(sessionId);
                })
                .doOnError(error -> {
                    log.error("LLM响应失败: sessionId={}", sessionId, error);
                    context.setCurrentAssistantMessage(null);
                });
    }

    /**
     * 构建消息列表
     * 包含系统提示和历史对话
     */
    private List<Map<String, String>> buildMessages(SessionManager.SessionContext context, String userMessage) {
        List<Map<String, String>> messages = new ArrayList<>();

        // 添加系统提示
        String systemPrompt = context.getSystemPrompt() != null
                ? context.getSystemPrompt()
                : DEFAULT_SYSTEM_PROMPT;
        messages.add(Map.of("role", "system", "content", systemPrompt));

        // 添加历史对话（限制长度）
        List<Map<String, String>> history = context.getConversationHistory();
        int startIndex = Math.max(0, history.size() - MAX_HISTORY_LENGTH);
        messages.addAll(history.subList(startIndex, history.size()));

        // 添加当前用户消息
        if (userMessage != null && !userMessage.isEmpty()) {
            messages.add(Map.of("role", "user", "content", userMessage));
        }

        return messages;
    }

    /**
     * 取消当前生成
     */
    public void abortGeneration(String sessionId) {
        log.info("取消LLM生成: sessionId={}", sessionId);

        SessionManager.SessionContext context = sessionManager.getSession(sessionId);
        if (context != null) {
            context.setCurrentAssistantMessage(null);
        }

        sessionManager.setSessionState(sessionId, SessionManager.SessionState.IDLE);
    }

    /**
     * 设置系统提示
     */
    public void setSystemPrompt(String sessionId, String systemPrompt) {
        SessionManager.SessionContext context = sessionManager.getSession(sessionId);
        if (context != null) {
            context.setSystemPrompt(systemPrompt);
            log.info("系统提示已更新: sessionId={}", sessionId);
        }
    }

    /**
     * 清空对话历史
     */
    public void clearHistory(String sessionId) {
        SessionManager.SessionContext context = sessionManager.getSession(sessionId);
        if (context != null) {
            context.getConversationHistory().clear();
            log.info("对话历史已清空: sessionId={}", sessionId);
        }
    }

    /**
     * 获取对话历史
     */
    public List<Map<String, String>> getHistory(String sessionId) {
        SessionManager.SessionContext context = sessionManager.getSession(sessionId);
        if (context == null) {
            return new ArrayList<>();
        }
        return new ArrayList<>(context.getConversationHistory());
    }
}
