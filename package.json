{
  "name": "kuakua-mirror",
  "version": "0.0.1",
  "private": false,
  "description": "KuaKua Mirror - 智能镜子项目 Monorepo",
  "author": "curusdoyle",
  "scripts": {
    "dev": "pnpm --filter './packages/*' --parallel dev",
    "build": "pnpm --filter './packages/*' build",
    "lint": "oxlint .",
    "fmt": "oxfmt --fix .",
    "fmt:check": "oxfmt .",
    "clean": "pnpm --filter './packages/*' --parallel clean && pnpm --filter './tools/*' --parallel clean"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
