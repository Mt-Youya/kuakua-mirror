{
  "name": "kuakua-mirror",
  "version": "0.0.1",
  "private": false,
  "description": "KuaKua Mirror - 智能镜子项目 Monorepo",
  "author": "curusdoyle",
  "scripts": {
    "dev": "pnpm --filter './packages/*' --parallel dev",
    "build": "pnpm --filter './packages/*' build",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt .",
    "clean": "pnpm --filter './packages/*' --parallel clean && pnpm --filter './tools/*' --parallel clean"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
